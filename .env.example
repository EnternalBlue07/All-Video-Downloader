# ==============================================================================
# MEDIAOS Intelligence Engine - Environment Configuration
# Built by Mohammad Zumaan Sayyed
# ==============================================================================

# Server Network Settings
MEDIAOS_HOST=0.0.0.0
MEDIAOS_PORT=8000
MEDIAOS_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# UI Development Server
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# Storage Directories
MEDIAOS_STORAGE_DIR=mediaos_backend/storage
MEDIAOS_DOWNLOADS_DIR=mediaos_backend/downloads
MEDIAOS_EXPORTS_DIR=mediaos_backend/downloads/exports

# Processing Engine Configurations
MEDIAOS_DEFAULT_CONTAINER=mp4
MEDIAOS_DEFAULT_QUALITY=1080p
MEDIAOS_DEFAULT_AUDIO_CODEC=opus
MEDIAOS_SPONSORBLOCK_ENABLED=true
MEDIAOS_AI_ANALYSIS_ENABLED=true

# Database Settings
MEDIAOS_SQLITE_TIMEOUT=30.0
MEDIAOS_SQLITE_WAL_MODE=true

# FFmpeg Executable Override (Leave blank to use system PATH)
# FFMPEG_BINARY_PATH=/usr/bin/ffmpeg
# FFPROBE_BINARY_PATH=/usr/bin/ffprobe
